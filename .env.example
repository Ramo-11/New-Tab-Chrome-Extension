# Only needed for the Node/Bun harness in harness/. The extension asks for the key in its UI.
# Create the key in a Google AI Studio project that has no billing account (aistudio.google.com/apikey), so it can never be charged.
GEMINI_API_KEY=
# Optional: standing instructions for harness runs (same as the extension's Settings box)
HOMEPAGE_PROMPT=
# Optional: one of gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
HOMEPAGE_MODEL=
